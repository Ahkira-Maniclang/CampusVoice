<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createAccountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg">

    <!-- FIXED BACK BUTTON -->
    <ImageView
        android:id="@+id/registrationBackArrow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Go back"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- SCROLLABLE FORM BELOW BACK BUTTON -->
    <ScrollView
        android:id="@+id/registrationScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/registrationBackArrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/registrationForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintWidth_max="520dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- CREATE ACCOUNT ICON -->
                <ImageView
                    android:id="@+id/createAccountIcon"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:src="@drawable/create_account_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Create Account Icon" />

                <!-- TITLE -->
                <TextView
                    android:id="@+id/createAccountTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Create an Account"
                    android:textSize="@dimen/login_heading_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    android:gravity="center" />

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/createAccountDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Please fill in the form below to register your account."
                    android:textSize="@dimen/login_body_size"
                    android:textColor="#43556B"
                    android:gravity="center" />

                <!-- FULL NAME ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/fullNameIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="@null"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/fullNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Full Name"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/fullNameInput" />
                </LinearLayout>

                <!-- FULL NAME INPUT -->
                <EditText
                    android:id="@+id/fullNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Enter your full name"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- STUDENT ID ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/studentIdIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/reg_student_id"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/identifierLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Student ID"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/identifierInput" />
                </LinearLayout>

                <!-- STUDENT ID INPUT -->
                <EditText
                    android:id="@+id/identifierInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Enter your student ID"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- EMAIL ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/emailIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/reg_email"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/emailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Email Address"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/emailInput" />
                </LinearLayout>

                <!-- EMAIL INPUT -->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Enter your email address"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- USERNAME ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/registrationUsernameIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="@null"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/registrationUsernameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Username"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/registrationUsernameInput" />
                </LinearLayout>

                <!-- USERNAME INPUT -->
                <EditText
                    android:id="@+id/registrationUsernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Choose a username"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- PASSWORD ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/registrationPasswordIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/registrationPasswordLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Password"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/registrationPasswordInput" />
                </LinearLayout>

                <!-- PASSWORD INPUT WITH EYE ICON -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/registrationPasswordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#25BEC9"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#164B78">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registrationPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:hint="Create a password"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:textColor="#164B78"
                        android:textColorHint="#687785"
                        android:textSize="@dimen/login_body_size" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONFIRM PASSWORD ICON AND LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/confirmPasswordIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/confirmPasswordLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Confirm Password"
                        android:textColor="#164B78"
                        android:textSize="@dimen/login_label_size"
                        android:textStyle="bold"
                        android:labelFor="@id/confirmPasswordInput" />
                </LinearLayout>

                <!-- CONFIRM PASSWORD INPUT WITH EYE ICON -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#25BEC9"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#164B78">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:hint="Confirm your password"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:textColor="#164B78"
                        android:textColorHint="#687785"
                        android:textSize="@dimen/login_body_size" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ACCOUNT TYPE -->
                <TextView
                    android:id="@+id/registrationAccountTypeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Account Type"
                    android:textColor="#164B78"
                    android:textSize="@dimen/login_label_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accountTypeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Select the type of account you want to create."
                    android:textColor="#43556B"
                    android:textSize="@dimen/login_small_size" />

                <!-- STUDENT AND ADMINISTRATOR OPTIONS -->
                <RadioGroup
                    android:id="@+id/registrationAccountTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RadioButton
                        android:id="@+id/registrationStudent"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:padding="8dp"
                        android:text="Student"
                        android:textSize="@dimen/login_role_size"
                        android:textStyle="bold"
                        android:textColor="#164B78"
                        android:buttonTint="#25BEC9"
                        android:drawableTop="@drawable/reg_student"
                        android:drawablePadding="6dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="#C9F4F5"
                        android:gravity="center"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/registrationAdministrator"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:padding="8dp"
                        android:text="Administrator"
                        android:textSize="@dimen/login_role_size"
                        android:textStyle="bold"
                        android:textColor="#164B78"
                        android:buttonTint="#25BEC9"
                        android:drawableTop="@drawable/reg_admin"
                        android:drawablePadding="6dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="#C9F4F5"
                        android:gravity="center" />

                </RadioGroup>

                <!-- ROLE DESCRIPTIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Submit complaints and feedback"
                        android:textSize="@dimen/login_small_size"
                        android:textColor="#43556B"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Manage complaints and records"
                        android:textSize="@dimen/login_small_size"
                        android:textColor="#43556B"
                        android:gravity="center" />

                </LinearLayout>

                <!-- ADMIN CODE SECTION -->
                <LinearLayout
                    android:id="@+id/adminCodeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/adminKeyIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/reg_key"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/adminCodeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Administrator Registration Code"
                            android:textColor="#164B78"
                            android:textSize="@dimen/login_label_size"
                            android:textStyle="bold"
                            android:labelFor="@id/adminCodeInput" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/adminCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="#FFFFFF"
                        android:hint="Enter administrator registration code"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#164B78"
                        android:textColorHint="#687785"
                        android:textSize="@dimen/login_body_size" />

                </LinearLayout>

                <!-- TERMS AND CONDITIONS -->
                <CheckBox
                    android:id="@+id/termsCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="18dp"
                    android:text="I agree to the Terms and Conditions and Privacy Policy."
                    android:textColor="#164B78"
                    android:textSize="@dimen/login_small_size"
                    android:buttonTint="#25BEC9" />

                <!-- CREATE ACCOUNT BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitRegistrationButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="CREATE ACCOUNT"
                    android:textAllCaps="false"
                    android:textColor="#164B78"
                    android:textSize="@dimen/login_button_size"
                    android:textStyle="bold"
                    app:backgroundTint="#7EDFE3"
                    app:cornerRadius="18dp" />

                <!-- RETURN TO LOGIN -->
                <TextView
                    android:id="@+id/backToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Already have an account? Log In"
                    android:textColor="#16809A"
                    android:textSize="@dimen/login_small_size"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
