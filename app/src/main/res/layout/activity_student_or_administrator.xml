<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".StudentOrAdministrator">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="1013dp"
        android:layout_height="894dp"
        android:background="@null"
        android:padding="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.666"
        app:srcCompat="@mipmap/background_foreground" />

    <ImageButton
        android:id="@+id/imageButton6"
        android:layout_width="577dp"
        android:layout_height="462dp"
        android:background="@null"
        android:padding="0dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/wavy_foreground"
        tools:layout_editor_absoluteY="-60dp" />

    <ImageButton
        android:id="@+id/imageButton7"
        android:layout_width="577dp"
        android:layout_height="462dp"
        android:background="@null"
        android:padding="0dp"
        android:rotation="180"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/wavy_foreground"
        tools:layout_editor_absoluteY="475dp" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="459dp"
        android:layout_height="394dp"
        app:srcCompat="@mipmap/admin_foreground"
        tools:layout_editor_absoluteX="-24dp"
        tools:layout_editor_absoluteY="-59dp" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="364dp"
        android:layout_height="277dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/student_foreground"
        tools:layout_editor_absoluteY="615dp" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="251dp"
        android:layout_height="307dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/or_foreground"
        tools:layout_editor_absoluteY="292dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
