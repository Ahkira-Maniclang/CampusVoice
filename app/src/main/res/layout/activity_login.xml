<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    tools:context=".LoginActivity">

    <!-- RESPONSIVE SCROLL AREA -->
    <ScrollView
        android:id="@+id/loginScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CENTERED CONTENT CONTAINER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp">

            <LinearLayout
                android:id="@+id/loginForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="55dp"
                android:layout_marginBottom="28dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintWidth_max="520dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- LOGIN LOGO -->
                <ImageView
                    android:id="@+id/loginLogo"
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:src="@drawable/login_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Campus Voice Logo" />

                <!-- SYSTEM TITLE -->
                <TextView
                    android:id="@+id/systemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="STUDENT COMPLAINT AND&#10;FEEDBACK SYSTEM"
                    android:textSize="@dimen/login_title_size"
                    android:textColor="#164B78"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <!-- TITLE DIVIDER -->
                <TextView
                    android:id="@+id/titleDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="────── ✦ ──────"
                    android:textColor="#164B78"
                    android:textSize="@dimen/login_small_size"
                    android:gravity="center" />

                <!-- LOGIN HEADING -->
                <TextView
                    android:id="@+id/loginHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="LOGIN"
                    android:textSize="@dimen/login_heading_size"
                    android:textColor="#164B78"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- LOGIN DESCRIPTION -->
                <TextView
                    android:id="@+id/loginDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enter your credentials to&#10;access your account"
                    android:textSize="@dimen/login_body_size"
                    android:textColor="#43556B"
                    android:gravity="center" />

                <!-- ACCOUNT TYPE LABEL -->
                <TextView
                    android:id="@+id/accountTypeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="SELECT ACCOUNT TYPE"
                    android:textSize="@dimen/login_label_size"
                    android:textColor="#164B78"
                    android:textStyle="bold" />

                <!-- ACCOUNT TYPE SELECTION -->
                <RadioGroup
                    android:id="@+id/accountTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RadioButton
                        android:id="@+id/radioStudent"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Student"
                        android:textSize="@dimen/login_role_size"
                        android:textStyle="bold"
                        android:textColor="#164B78"
                        android:buttonTint="#25BEC9"
                        android:checked="true"
                        android:gravity="center_vertical" />

                    <RadioButton
                        android:id="@+id/radioAdministrator"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Administrator"
                        android:textSize="@dimen/login_role_size"
                        android:textStyle="bold"
                        android:textColor="#164B78"
                        android:buttonTint="#25BEC9"
                        android:gravity="center_vertical" />

                </RadioGroup>

                <!-- USERNAME LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/usernameIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Username Icon"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/usernameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="USERNAME"
                        android:textSize="@dimen/login_label_size"
                        android:textColor="#164B78"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- USERNAME INPUT -->
                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Enter your username"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- PASSWORD LABEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/passwordIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Password Icon"
                        app:tint="#164B78" />

                    <TextView
                        android:id="@+id/passwordLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="PASSWORD"
                        android:textSize="@dimen/login_label_size"
                        android:textColor="#164B78"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PASSWORD INPUT -->
                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#164B78"
                    android:textColorHint="#687785"
                    android:textSize="@dimen/login_body_size" />

                <!-- FORGOT PASSWORD -->
                <TextView
                    android:id="@+id/forgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="Forgot Password?"
                    android:textSize="@dimen/login_small_size"
                    android:textColor="#16809A"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- LOGIN BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="14dp"
                    android:text="LOGIN"
                    android:textAllCaps="false"
                    android:textSize="@dimen/login_button_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    android:gravity="center"
                    app:backgroundTint="#7EDFE3"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_login_button"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:iconTint="#164B78" />

                <!-- OR DIVIDER -->
                <TextView
                    android:id="@+id/orDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="──────── OR ────────"
                    android:textSize="@dimen/login_small_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    android:gravity="center" />

                <!-- CREATE ACCOUNT BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="10dp"
                    android:text="CREATE AN ACCOUNT"
                    android:textAllCaps="false"
                    android:textSize="@dimen/login_body_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    app:backgroundTint="#7EDFE3"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_create_acc_button"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:iconTint="#164B78" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- BACK ARROW -->
    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Back to Welcome"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
