<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg"
    tools:context=".LoginInterface">

    <!-- RESPONSIVE SCROLL AREA -->
    <ScrollView
        android:id="@+id/welcomeScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- MAIN CONTENT CONTAINER -->
            <LinearLayout
                android:id="@+id/welcomeContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="@dimen/welcome_vertical_padding"
                android:layout_marginBottom="@dimen/welcome_vertical_padding"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintWidth_max="520dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- SHIELD LOGO -->
                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="@dimen/welcome_logo_width"
                    android:layout_height="@dimen/welcome_logo_height"
                    android:src="@drawable/welcome_shieldlogo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Campus Voice Shield Logo" />

                <!-- SYSTEM TITLE -->
                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="STUDENT COMPLAINT AND&#10;FEEDBACK SYSTEM"
                    android:textSize="@dimen/welcome_title_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:lineSpacingExtra="3dp" />

                <!-- WELCOME ILLUSTRATION -->
                <ImageView
                    android:id="@+id/welcomeIllustration"
                    android:layout_width="@dimen/welcome_illustration_width"
                    android:layout_height="@dimen/welcome_illustration_height"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/welcome_illustration"
                    android:scaleType="fitCenter"
                    android:contentDescription="Welcome Illustration" />

                <!-- WELCOME HEADING -->
                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="WELCOME!"
                    android:textSize="@dimen/welcome_heading_size"
                    android:textStyle="bold"
                    android:textColor="#164B78"
                    android:gravity="center" />

                <!-- WELCOME SUBTITLE -->
                <TextView
                    android:id="@+id/welcomeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Share your concerns.&#10;Help us improve."
                    android:textSize="@dimen/welcome_subtitle_size"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:lineSpacingExtra="3dp" />

                <!-- LOGIN BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/welcome_button_height"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:text="➜ LOGIN"
                    android:textSize="@dimen/welcome_login_button_size"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:textAllCaps="false" />

                <!-- CREATE ACCOUNT BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/createAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/welcome_button_height"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="10dp"
                    android:text="👤+ CREATE AN ACCOUNT"
                    android:textSize="@dimen/welcome_create_button_size"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
